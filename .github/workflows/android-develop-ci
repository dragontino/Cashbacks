name: Android build and test project on develop

on:
  pull_request:
    branches:
      - "develop"
  push:
    branches:
      - "develop"

jobs:
  setup-environment:
    name: Update version number
    runs-on: ubuntu-latest

    env:
      REPO_OWNER: ${{ github.repository_owner }}
      REPO_NAME: ${{ github.event.repository.name }}

    steps:
      - name: Increment repo BUILD_NUMBER variable
        env:
          GH_TOKEN: ${{ secrets.PAT_UPDATE_VARS }}
        run: |
          VAR_NAME="BUILD_NUMBER"
          API="https://api.github.com/repos/$REPO_OWNER/$REPO_NAME/actions/variables/$VAR_NAME"

          CURRENT=$(curl -s -H "Authorization: Bearer $GH_TOKEN" "$API" | jq -r .value)
          NEXT=$((CURRENT+1))

          curl -s -X PATCH "$API" \
            -H "Authorization: Bearer $GH_TOKEN" \
            -H "Content-Type: application/json" \
            -d "{\"name\":\"VAR_NAME\",\"value\":\"$NEXT\"}"

          echo "BUILD_NUMBER=$NEXT" >> "$GITHUB_ENV"

      - name: Set up app url
        run: |
          API="https://api.github.com/repos/$REPO_OWNER/$REPO_NAME/"
          echo "REPOS_URL=$API" >> "$GITHUB_ENV"
  build:
    needs: setup-environment
    name: Build project
    runs-on: ubuntu-latest

    steps:
    - name: Checkout
      uses: actions/checkout@v4

    - name: set up JDK
      uses: actions/setup-java@v4
      with:
        java-version: '17'
        distribution: 'temurin'
        cache: gradle

    - name: Grant execute permission for gradlew
      run: chmod +x gradlew

    - name: Build with Gradle
      run: ./gradlew clean build

  unit-test:
    needs: build
    name: Run unit tests on PR in develop
    runs-on: ubuntu-latest

    steps:
      - name: Run unit tests
        run: ./gradlew test
